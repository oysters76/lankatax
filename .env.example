# Database (used by docker-compose and backend) 
POSTGRES_DB_NAME=lankatax
POSTGRES_USER=lankatax_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM Providers 
OPENAI_API_KEY=your_openai_token_here
GOOGLE_API_KEY=your_google_token_here
GROQ_API_KEY=your_groq_token_here

# Ingestion
CHUNK_STRATEGY=structural

# LangSmith Observability
LANGCHAIN_API_KEY=your_langchain_key_here
LANGCHAIN_PROJECT=lankatax
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

