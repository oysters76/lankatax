# Database (used by docker-compose and backend) 
POSTGRES_DB_NAME=lankatax
POSTGRES_USER=lankatax_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM Providers 
OPENAI_API_KEY=your_openai_token_here
GOOGLE_API_KEY=your_google_token_here
GROQ_API_KEY=your_groq_token_here
DEEPSEEK_API_KEY=your_deepseek_token_here

# Ingestion
CHUNK_STRATEGY=structural
EMBEDDING_BATCH_MAX_TOKENS=8000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BACKOFF_BASE_SECONDS=1.0
EMBEDDING_BACKOFF_MAX_SECONDS=10.0
EMBEDDING_JITTER_RATIO=0.2

# Prompts (local YAML by default; use "hub" to pull from LangSmith Hub)
LANKATAX_PROMPT_SOURCE=local
# LANKATAX_PROMPTS_DIR=./prompts
# LANKATAX_PROMPT_OVERRIDES=answer=v2
# Required when LANKATAX_PROMPT_SOURCE=hub, e.g. owner or owner/project
# LANKATAX_PROMPT_HUB_PREFIX=

# LangSmith Observability (LANGSMITH_* preferred; LANGCHAIN_* still works)
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=lankatax-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy aliases: LANGCHAIN_API_KEY, LANGCHAIN_PROJECT,
# LANGCHAIN_TRACING_V2, LANGCHAIN_ENDPOINT

# API authentication (deployment: inject these via the platform secret store)
API_AUTH_USERNAME=admin
# Generate once:
#   uv run python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('your-password'))"
API_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# Generate once: openssl rand -hex 32  (API_KEY_TOKEN is accepted as an alias)
API_AUTH_SECRET=replace_me_with_openssl_rand_hex_32
API_AUTH_TOKEN_EXPIRE_MINUTES=30
# Docs guard. Keep true in production: read the spec with a token, or put the app
# behind an authenticated proxy. In a local .env set false to use Swagger in a
# browser (its Authorize button then logs in with the seeded credentials).
API_DOCS_REQUIRE_AUTH=true

# Hatchet background jobs (Cloud or self-hosted)
HATCHET_CLIENT_TOKEN=your_hatchet_token_here
# Self-hosted without TLS only:
# HATCHET_CLIENT_TLS_STRATEGY=none
# HATCHET_DASHBOARD_URL=https://cloud.hatchet.run
HATCHET_WORKER_NAME=lankatax-worker
HATCHET_WORKER_SLOTS=2

# Scheduled jobs (UTC)
JOB_REFRESH_CRON=0 2 * * *
JOB_CACHE_EXPIRE_CRON=0 3 * * *
JOB_EVAL_CRON=0 4 * * 1

# Per-job limits
JOB_SCRAPE_TIMEOUT_SECONDS=1800
JOB_INGEST_TIMEOUT_SECONDS=7200
JOB_CACHE_TIMEOUT_SECONDS=300
JOB_EVAL_TIMEOUT_SECONDS=3600
JOB_SCHEDULE_TIMEOUT_SECONDS=3600
JOB_MAX_TOKENS_PER_RUN=1000000
JOB_MAX_COST_USD=1.0
JOB_SCRAPE_MAX_URLS=1000
JOB_INGEST_MAX_DOCUMENTS=500
JOB_ENQUEUE_RATE_LIMIT_PER_MINUTE=10
